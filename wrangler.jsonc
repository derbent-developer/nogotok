{
  // Настройки Cloudflare. Сайт состоит из статических файлов в корне
  // репозитория, worker/index.js отвечает за вход в панель и работу с GitHub.
  "name": "nogotok",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  // не стирать секреты и переменные, заданные в панели Cloudflare
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
}
