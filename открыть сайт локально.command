#!/bin/bash
# ============================================================
#  Ноготок — предпросмотр сайта на этом компьютере
#  Нужен, только чтобы посмотреть правки до публикации.
#  Покупателям сайт доступен по адресу в интернете и без этого окна.
# ============================================================

cd "$(dirname "$0")" || exit 1
PORT=8000

echo "============================================================"
echo "  Предпросмотр магазина Ноготок"
echo "============================================================"
echo "  Витрина:  http://localhost:$PORT/"
echo "  Админка:  http://localhost:$PORT/admin.html"
echo
echo "  Закрыть предпросмотр: Ctrl + C"
echo "============================================================"
echo

( sleep 1.5; open "http://localhost:$PORT/" ) &
python3 -m http.server "$PORT"
